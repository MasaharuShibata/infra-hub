# GitHub personal access token with "repo" scope (issues: read/write, contents: write, pull_requests: write)
GITHUB_TOKEN=

# Repository to watch
GITHUB_OWNER=MasaharuShibata
GITHUB_REPO=infra-hub

# Absolute path to a local clone of the repo that this script may checkout branches in.
# Use a dedicated clone, not a working copy you edit by hand.
REPO_PATH=

# Base branch that new branches/PRs are created from
BASE_BRANCH=main

# Only issues carrying this label are processed
TARGET_LABEL=claude-task

# Label applied after a PR has been opened (removed from TARGET_LABEL)
DONE_LABEL=claude-done

# Polling interval in milliseconds
POLL_INTERVAL_MS=60000
